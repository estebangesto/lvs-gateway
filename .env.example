# OpenClaw routing. OPENCLAW_SESSION_KEY identifies the persistent
# conversation used by this voice client; it is not a secret.
OPENCLAW_API_URL=http://localhost:18789
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY=lvs-desktop

# TTS behavior. Do not set ELEVENLABS_API_KEY here: by default the service
# reads the active OpenClaw secret store configured by ELEVENLABS_SECRET_FILE.
TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=p7AwDmKvTdoHTBuueGvP
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=es
# Optional voice adjustments. Leave unset to use the provider's stored defaults.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# Legacy 2.5 model settings:
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1
# ELEVENLABS_USE_SPEAKER_BOOST=true

# Optional overrides for standalone deployments (never commit real values):
# OPENCLAW_API_TOKEN=
# ELEVENLABS_API_KEY=
# OPENCLAW_SECRET_FILE=/path/to/openclaw-secrets.json
# ELEVENLABS_SECRET_FILE=/path/to/openclaw-secrets.json
# STT_SOCKET_PATH=/run/user/<uid>/lvs-stt.sock
