[Unit]
Description=LVS Gateway (FastAPI + OpenClaw + ElevenLabs)
After=network-online.target lvs-stt.service

[Service]
WorkingDirectory=%h/.local/share/lvs-gateway
Environment="PATH=%h/.local/share/lvs-gateway/venv/bin"
ExecStart=%h/.local/share/lvs-gateway/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
