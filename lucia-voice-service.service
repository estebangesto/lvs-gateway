[Unit]
Description=Luc.ia Voice Service (FastAPI + OpenClaw + ElevenLabs)
After=network-online.target lucia-stt.service

[Service]
WorkingDirectory=/opt/lucia-voice-service
Environment="PATH=/opt/lucia-voice-service/venv/bin"
ExecStart=/opt/lucia-voice-service/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
