[Unit]
Description=Luc.ia Voice Service v3 (FastAPI + OpenClaw + ElevenLabs)
After=network-online.target lucia-stt.service

[Service]
WorkingDirectory=/opt/lucia-voice-service-v3
Environment="PATH=/opt/lucia-voice-service-v3/venv/bin"
# Usamos el puerto 8001 para no chocar con la v2
ExecStart=/opt/lucia-voice-service-v3/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 1

Restart=always
RestartSec=5

[Install]
WantedBy=default.target
